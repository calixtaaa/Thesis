[Desktop Entry]
Type=Application
Name=Hygiene Vending Machine
Comment=Launch vending machine UI (manual start)
Exec=bash -lc 'cd "%PROJECT_DIR%" && source venv/bin/activate && export DISPLAY=:0 && export PYTHONNOUSERSITE=1 && export MCP23017_ADDRESSES=0x20,0x21,0x22 && export UI_LCD_SCALE=1.6 && exec venv/bin/python main.py'
Terminal=false
Categories=Utility;
